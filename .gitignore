# сборка и кэш
firmware/build/
__pycache__/
*.pyc

# IDF-проект: артефакты сборки и скачанные компоненты не держим в git
idf/build/
idf/build-diag/
idf/managed_components/
idf/sdkconfig
idf/sdkconfig.old
idf/dependencies.lock

# каталог сборки IDF, если запускать из корня проекта (idf.py -B build-diag)
build-diag/

# инструменты: локальные бинарники (54 МБ), не в git
tools/*.exe
tools/*.msi

# дампы прошивок (8 МБ каждый)
firmware/backup/

# локальные дампы «чёрного ящика» и синтетические проверки
tools/diag-raw.bin
tools/diag-test.bin

# комплект для заливки на другом ПК: образы не версионируем (их кладут из сборок),
# инструкции и .bat — в git
flash-kit/*/*.bin
flash-kit.zip

# локальные превью кадров
host/*.png
host/config.json.bak

# архив залитых сборок (bin/elf/map по 5-10 МБ) — локально, чтобы можно было
# расшифровать coredump и адреса паники именно той сборки, что была прошита
firmware/idf-builds/

# готовый архив для переноса на другой ПК (собирается tools/make_flash_kit.py)
flash-kit-inkmetrics-*.zip

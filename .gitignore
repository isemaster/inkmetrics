# сборка и кэш
firmware/build/
__pycache__/
*.pyc

# IDF-проект: артефакты сборки и скачанные компоненты не держим в git
idf/build/
idf/build-diag/
idf/managed_components/
idf/sdkconfig
idf/sdkconfig.old
idf/dependencies.lock

# каталог сборки IDF, если запускать из корня проекта (idf.py -B build-diag)
build-diag/

# инструменты: локальные бинарники (54 МБ), не в git
tools/*.exe
tools/*.msi

# дампы прошивок и «чёрного ящика»
firmware/backup/
firmware/diag-*.bin
tools/diag-raw.bin
tools/diag-test.bin

# образ диска прибора: собирается `python tools/make_setup_disk.py` из agent-kit/.
# Готовая копия лежит в комплекте (flash-kit/idf/) — она и версионируется.
firmware/media/*.img
firmware/media/msc-backup-*.bin

# архив залитых сборок (bin/elf/map по 5-10 МБ) — локально, чтобы можно было
# расшифровать coredump и адреса паники именно той сборки, что была прошита
firmware/idf-builds/

# готовый архив для переноса на другой ПК (собирается tools/make_flash_kit.py)
flash-kit-inkmetrics-*.zip
flash-kit.zip

# рабочие заметки проекта: живут рядом, но в репозиторий не идут
MEMORY.md
ISSUES.md
NEXT-SESSION.md
instruction.md
RULES.md
PLAN.md
PLAN-ONDEVICE.md
TZ-SENTINEL-*.md
ТЗ_*.md

# локальные превью кадров
host/*.png
host/config.json.bak

# веб-прошивальщик: страница в репозитории, а образы для архива — генерируются
inkmetrics-webflash.html
inkmetrics-webflash-*.zip
